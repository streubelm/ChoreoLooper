<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ChoreoLooper" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <!-- main buttons -->
        <item name="colorPrimary">@color/blue</item>
        <!-- unused -->
        <item name="colorPrimaryVariant">@color/blue</item>
        <!-- buttons in title bar -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color (dimmed). -->
        <!-- button accent color -->
        <item name="colorSecondary">@color/bg_blue</item>
        <!-- time picker buttons -->
        <item name="colorSecondaryVariant">@color/dark_blue</item>
        <!-- text field borders -->
        <item name="colorOnSecondary">@color/light_black</item>

        <!-- Accent color for seekbar slider -->
        <item name="colorAccent">@color/bg_blue</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/dark_blue</item>
        <item name="android:windowTitleBackgroundStyle">@color/dark_blue</item>

        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <!-- top-side shadow gradient -->
        <item name="shadowTop">@drawable/shadowtop_dark</item>

        <!-- Customize your theme here. -->
        <item name="android:timePickerStyle">@style/MyTimePickerStyle</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
    </style>


    <style name="DrawerArrowStyle" parent="@style/Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="thickness">3.66dp</item>
        <item name="barLength">28dp</item>
        <item name="gapBetweenBars">5.33dp</item>
        <item name="drawableSize">50dp</item>
        <item name="color">@color/white</item>
        <item name="arrowShaftLength">28dp</item>
        <item name="arrowHeadLength">12dp</item>
    </style>

    <style name="ThemeOverlay.AppCompat.navTheme">
        <item name="colorPrimary">@color/white</item>
        <item name="colorControlHighlight">@color/white</item>
    </style>

    <style name="MyTimePickerStyle" parent="android:Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
    </style>

    <style name="RoundedBGButtonStyle" parent="android:Widget.Material.Button">
        <item name="android:backgroundTint">@color/dark_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

</resources>